# All values must be supplied via your local .env file. Copy this file to
# .env and fill in real values. .env is git-ignored — it must NEVER be
# committed, and it must NEVER contain values you would not write on a postcard.
#
# All variables are required. The bot refuses to start if any is missing
# (see _require() in bot.py).

# Telegram bot token from @BotFather. Format: <digits>:<base64-ish>
BOT_TOKEN=

# OpenAI-compatible chat-completions endpoint, e.g.:
#   http://localhost:8080/v1          (llama-server on the same host)
#   http://llama-rocm:8080/v1         (llama-server in another container)
LLAMA_URL=

# Bearer token for the LLM endpoint. llama-server accepts any non-empty
# value when started without --api-key.
API_KEY=

# Model name sent in chat-completions. Must match --alias on the server.
MODEL=

# Whisper /v1/audio/transcriptions endpoint.
WHISPER_URL=

# === Security: bot will reject anyone not in this list ===
# Comma-separated numeric Telegram user IDs.
ALLOWED_USER_IDS=

# Comma-separated Telegram usernames (case-insensitive, without @).
ALLOWED_USERNAMES=
