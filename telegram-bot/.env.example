# Telegram bot token — get it from @BotFather on Telegram
# Format: 1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=replace_me_with_real_token_from_botfather

# OpenAI-compatible LLM endpoint. Examples:
#   http://localhost:8080/v1          (llama-server on the host)
#   http://192.168.1.42:8080/v1       (llama-server on a LAN host)
#   http://llama-rocm:8080/v1         (llama-server in another docker container)
LLAMA_URL=http://localhost:8080/v1

# llama-server auth. Most local servers accept any token, but a value is required.
API_KEY=sk-no-key

# Model name to send in the chat/completions request. Must match --alias on the server.
MODEL=Qwen3.6-35B-A3B-Heretic

# Whisper API endpoint (compatible with OpenAI /v1/audio/transcriptions).
WHISPER_URL=http://localhost:8000

# SearXNG endpoint for the bot's searxng_search tool.
# Default 8888 is the port the bundled docker-compose maps to the host.
SEARXNG_URL=http://localhost:8888

# === Security: bot will reject anyone not in this list ===
# Comma-separated numeric Telegram user IDs.
#   ALLOWED_USER_IDS=123456789,987654321
# When BOTH ALLOWED_USER_IDS and ALLOWED_USERNAMES are empty, the bot is
# in LOCKDOWN and rejects every message (safe default).
ALLOWED_USER_IDS=

# Comma-separated Telegram usernames (case-insensitive, without @).
ALLOWED_USERNAMES=
