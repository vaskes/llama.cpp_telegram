# Telegram bot token (obtain from @BotFather on Telegram).
# Required. Bot will not start without this.
BOT_TOKEN=

# Optional: shared bearer token for llama-server if it is behind a
# reverse proxy that requires one. If llama-server is on a private
# LAN, leave empty.
API_KEY=

# OpenAI-compatible chat-completions endpoint. Examples:
#   http://localhost:8080/v1                 (host network)
#   http://192.168.10.6:8080/v1              (LAN)
#   https://api.openai.com/v1                (OpenAI cloud)
LLAMA_URL=http://localhost:8080/v1

# Whisper endpoint for voice messages. OpenAI-compatible
# /v1/audio/transcriptions. Leave the default if you run
# whisper-api via the included whisper-api/docker-compose.yml
# on the same host or on the same macvlan network.
WHISPER_URL=http://localhost:8000

# Donsetch MCP endpoint for web search / fetch / crawl.
# Leave empty to disable web tools.
DONSETCH_URL=

# Model name. Free-form; passed verbatim to llama-server.
MODEL=

# Whitelist (comma-separated). Telegram user_id (numeric) or
# @username. Empty list = LOCKDOWN in private mode (no one can
# talk to the bot). In a group, the conversation path is enforced at
# chat_member join time -- but that covers talking, not commands.
#
# Since 2026-10-22 this list also gates every slash command and the
# inline-keyboard callbacks, in a group as well as in private. Put the
# administrators in here; a public group otherwise lets any member
# /delsub its topics and /reset its history, because Telegram has no ACL
# for deleteForumTopic.
ALLOWED_USER_IDS=
ALLOWED_USERNAMES=

# Transport: 0 = long-polling (default), 1 = webhook.
# See docs/WEBHOOK.md for the public-endpoint / reverse-proxy
# requirements when WEBHOOK_MODE=1.
WEBHOOK_MODE=0

# Public URL Telegram should POST to. If set together with
# WEBHOOK_MODE=1 and WEBHOOK_SECRET_TOKEN, the bot auto-registers
# the webhook with Telegram on startup. Example:
#   WEBHOOK_URL=https://bot.example.com/tg-webhook
# Leave empty to register manually via setWebhook (see docs/WEBHOOK.md).
WEBHOOK_URL=

# Required only when WEBHOOK_MODE=1. Long random string. Telegram
# sends this in the X-Telegram-Bot-Api-Secret-Token header on
# every webhook POST; the bot rejects requests that do not match.
# Generate with:  openssl rand -hex 16
#
# T57 #S21: this token is captured at import time (same M3
# pattern as AGENT_STACK_TOKEN). After editing this value
# you MUST restart the bot for the new value to take effect:
#     sudo systemctl restart telegram-bot-compose.service
WEBHOOK_SECRET_TOKEN=

# Set to 1 to run the in-tree _selftest() before starting the bot.
# Used in CI; leave at 0 in production.
LLAMABOT_SELFTEST=0

# === Personal mode (bash_command) ===
# These three keys are required to enable the bash_command tool.
# They are documented in docs/BASH-SANDBOX.md. Without them,
# /start shows "🚫 Shell-команды недоступны в этом режиме"
# even if you set LLAMABOT_DEPLOYMENT_PROFILE=personal.
#
# After editing AGENT_STACK_TOKEN you MUST restart the bot:
#   sudo systemctl restart telegram-bot-compose.service
# (the token is read at import time, not per call).
#
# LLAMABOT_DEPLOYMENT_PROFILE=public
# AGENT_STACK_URL=http://192.168.10.7:8090
# AGENT_STACK_TOKEN=
# LLAMABOT_BASH_RPM=10

# === Optional knobs (defaults are sensible) ===

# Where the conversation SQLite lives. Default: /app/data/conversations.db
# (the named Docker volume bot_data, see SECURITY.md §3.5.1).
# CONVERSATIONS_DB=/app/data/conversations.db

# --- Context memory (T70) ---
# Which assembled history goes to the engine each turn. The bot is a thin
# proxy and the engine is a swappable third party (llama / vLLM / Strata /
# anything OpenAI-compatible), so this policy lives in the BOT, never in the
# engine. Valid values: window (default), summarize.
# CONTEXT_STRATEGY=window

# Message-count ceiling, applied on top of the window. This is a safety net,
# not the policy: a week of a heated argument is hundreds of messages and
# should all be sent.
# CONTEXT_MAX_MESSAGES=20

# Length of the memory window, in days. IMPORTANT: this is the LENGTH of the
# window, not "how many days back to look". The window start is anchored once
# at bot start and does NOT slide — so with 7 the bot keeps everything from the
# week before it started, plus everything since. The daily re-anchor
# (BOT_REANCHOR_MODE, below) is what moves it. 0 or a negative value disables
# the age filter entirely.
# BOT_REMEMBER_DAYS=7

# --- T70.5: chunked summaries (CONTEXT_STRATEGY=summarize only) ------------
# Only used when CONTEXT_STRATEGY=summarize. In `window` mode these are read
# and ignored.
#
# WHAT THE STRATEGY DOES. At the daily re-anchor, the part of the history that
# fell out of the memory window is compressed into CHUNKS: the same model that
# answers the bot reads one chunk and writes a short summary of it. Each chunk
# is summarised ONCE, ever -- the messages of a summarised chunk get a marker
# ("СВЕДЕНО") in SQLite pointing at the summary that stands for them, and a
# marked chunk is never summarised again. The context the engine sees is then
# the finished summaries (each standing in the place of its own chunk) plus
# the old messages that were never summarised.
#
# WHY THE NUMBERS ARE IN TOKENS AND WHY THEY ARE ESTIMATED. The bot is
# engine-agnostic: it does not know which engine serves it, so it has no
# tokenizer and cannot ask for one. It estimates (characters / 3.75, which
# matches the measured 1 MB ~ 280k tokens, plus a 15% safety margin) and uses
# the estimate for BUDGETS. A budget that is 15% conservative costs nothing;
# a budget that is 15% optimistic is a prompt the engine refuses.
#
# SUMMARY_TAIL_TOKENS — how much old, never-summarised history may be loaded
# into the prompt AS IS (raw, not compressed). Below this, the operator's rule
# is "не сводить, а грузить как есть"; above it, the old part is summarised.
# Default 65536 (64k). Why 64k and not 200k: the engine's window is 256k and
# llama's thinking block takes 64k of it, so 200k of raw history plus the
# fresh window plus the thinking block does not fit — and the way it fails is
# the "the model thought and did not answer" failure. 64k leaves room:
# 262144 - 65536 (thinking) - 16384 (answer) - ~48000 (fresh window)
# - ~4000 (system + tools) = ~128k for the old part.
# SUMMARY_TAIL_TOKENS=65536
#
# SUMMARY_CHUNK_TOKENS — how much old history goes into ONE summarisation
# call. Each chunk is one model call, so this is also the granularity of the
# compression: a 64k chunk summarised to ~1k tokens is roughly a 64x
# compression. Default 65536 (64k) — a quarter of the engine window, which
# leaves room for the summariser's own thinking and its answer.
# SUMMARY_CHUNK_TOKENS=65536
#
# SUMMARY_CONTEXT_TOKENS — the ceiling on the OLD part of the prompt as a
# whole: the summaries plus the raw tail together. When they do not fit, the
# OLDEST is dropped, because the recent past is the part worth keeping.
# Default 131072 (128k) = 2 x SUMMARY_TAIL_TOKENS. Lower it if your engine's
# window is smaller than 256k.
# SUMMARY_CONTEXT_TOKENS=131072

# --- T68: how the memory window gets re-anchored (daily) -------------------
# Read ADR-0003 first: docs/adr/ADR-0003-context-reanchoring.md
#
# The short version: the window is a timestamp the bot computes locally. The
# engine is not part of it. Restarting the engine is VRAM hygiene, NOT context
# correctness.
#
# soft            the bot re-anchors itself on an internal timer. No systemd,
#                 no root, no access to the engine. Use this if you have no
#                 restart privileges, or your engine is on a host you do not
#                 control.
# process         this bot is restarted daily (systemd timer / cron); the
#                 anchor is recomputed on start.
# process+engine  as above, AND BOT_ENGINE_RESET_CMD runs afterwards to drop
#                 the engine's KV cache. Frees VRAM and stops the server slot
#                 growing unbounded under `--keep -1`.
# BOT_REANCHOR_MODE=process+engine

# Local time of day for the re-anchor, 24h HH:MM. Used by `soft` mode, and by
# the example systemd timer (examples/systemd/telegrambot-reanchor.timer) for
# the other modes.
# BOT_REANCHOR_AT=05:00

# Which timezone BOT_REANCHOR_AT is read in. Without it the value was
# interpreted in the *container's* zone, and the container is UTC -- so
# 05:00 fired at 08:00 for anyone who set it meaning their own morning.
# Any IANA name. Falls back to TZ, then UTC. An unusable name falls back
# to UTC and says so in the log rather than refusing to start.
# BOT_REANCHOR_TZ=Europe/Moscow
#
# TZ is honoured too, but only as a fallback when BOT_REANCHOR_TZ is
# unset. Setting TZ also shifts every other timestamp the bot logs,
# which is why it is the second choice and not the first.
# TZ=Europe/Moscow

# Command to drop the engine's KV cache after a `process+engine` re-anchor.
# Any shell command. Examples:
#   systemctl restart llama-qwen5090-256k.service
#   ssh -o BatchMode=yes llama-host 'systemctl restart llama-server'
#   curl -sf -X POST http://llama-host:8080/admin/reset
# Leave empty to leave the engine alone — a normal, valid setting. This runs
# as the bot user, un-sandboxed, and is never run on the request path.
# BOT_ENGINE_RESET_CMD=

# Number of past messages to send to the LLM on each turn. Default 20.
# Superseded by CONTEXT_MAX_MESSAGES (kept for backward compatibility).
# CONTEXT_MESSAGES=20

# Comma-separated list of tool names to NOT advertise to the LLM.
# Useful for stripping web_search in air-gapped deployments.
# DISABLED_TOOLS=

# Per-file size limits for incoming media (bytes). Default values
# are conservative; raise them if you have a fast connection and
# want the bot to accept larger files.
# MAX_PHOTO_BYTES=10000000
# MAX_VOICE_BYTES=20000000
# MAX_VIDEO_NOTE_BYTES=50000000
# MAX_DOC_BYTES=5000000

# Whisper language hint (BCP-47 code). Default "ru" because the
# operator is bilingual RU/EN; switch to "en" for an English-only
# deployment, or to "" to let Whisper auto-detect.
# WHISPER_LANGUAGE=ru

# Profile-specific tuning (only effective with the matching
# LLAMABOT_DEPLOYMENT_PROFILE). These override the profile
# defaults in limits.py. Most operators will never touch these.
# LLAMABOT_MAX_TOKENS=            # main response token cap
# LLAMABOT_MAX_TOKENS_CAPTION=    # photo/document-with-caption turns
# LLAMABOT_MAX_TOKENS_REACT_ONLY= # T65.1 silent absorb: reaction-only turn
# LLAMABOT_LLAMA_MODELS_TIMEOUT=  # GET /v1/models budget for /stats
# LLAMABOT_LOOP_BUDGET_SEC=       # wall-clock cap per turn
# LLAMABOT_LLAMA_HTTP_TIMEOUT=    # httpx timeout to llama-server
# LLAMABOT_TRANSCRIBE_TIMEOUT=    # httpx timeout to whisper-api
# LLAMABOT_MAX_ITER=              # how many times one turn may ask the
#                                 # engine and act on the answer (default
#                                 # 15). Not a profile knob: it is the
#                                 # same number everywhere unless a
#                                 # deployment sets it. Raising it gives a
#                                 # long task room AND a runaway loop
#                                 # room -- every iteration adds two
#                                 # messages to the context. See the
#                                 # description in limits.py.

# How much of the executed-tool transcript goes into the CHAT
# (default 4000 -- one Telegram message). The transcript grows with
# the number of commands the model ran: measured on production
# 2026-10-28, a 44-command turn produced 77 044 characters of
# console noise in front of a 4 110-character answer, and 8 of the
# 22 messages it became were delivered twice. The chat's copy is
# bounded to the head and the tail of the command list, with the
# drop marked; the bot's MEMORY keeps the whole transcript, so a
# follow-up question about what a command printed still has the
# answer. 0 means: no transcript in the chat at all.
# LLAMABOT_MAX_TRANSCRIPT_CHARS=4000

# === Debug knobs (off by default) ===

# Print the first 400 bytes of the JSON body the bot sends to
# llama-server on every call. Useful for diagnosing 5xx or
# malformed-JSON issues. Set to 1 to enable; do NOT leave on
# in production (logs are noisy and may include user content).
# LLAMABOT_DEBUG_PAYLOAD=0

# === Webhook server bind (only effective with WEBHOOK_MODE=1) ===
# Defaults: bind 0.0.0.0:8443, path /tg-webhook.
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/tg-webhook

# === T58: Developer mode (operator opt-in) ===
# UNRESTRICTED bash_command access in non-private chats. Required
# when you (the operator) want to run bash in a specific supergroup
# or channel, bypassing the T52 #H1 chat-type gate. The bot then
# is INVISIBLE in the user-facing chat by operator design
# (2026-10-14 11:19 MSK): no badge, no /start warning, no
# per-message prefix. The "scary red text" lives only in the
# code (see personal_tools/bash_command.py + limits.py).
#
# Both env vars must be set, in addition to AGENT_STACK_TOKEN:
#   LLAMABOT_DEPLOYMENT_PROFILE=dev
#   LLAMABOT_DEV_ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
# Where the chat_ids are the Telegram supergroup/channel IDs where
# you want bash enabled (negative for groups, positive for users/
# channels). The bot reads these at import time; restart required
# to take effect. Do NOT add chat_ids you do not fully control.
#
# LLAMABOT_DEPLOYMENT_PROFILE=dev
# LLAMABOT_DEV_ALLOWED_CHAT_IDS=


# Optional: bot's Telegram username without the leading @.
# Used for inline mention parsing in group messages. Leave
# empty if you do not need mention handling.
BOT_USERNAME=

# Optional: when set to 1, the bot asks users to rate
# responses with 👍/👎 reactions in group chats. Set to 0
# to disable rating entirely. Default: 0.
RATING_MODE=0

# Optional: explicit Telegram Bot API base URL. Default
# is https://api.telegram.org (production). Set this only
# for testing with a local Bot API server (smoke tests,
# self-hosted Telegram).
# TELEGRAM_API=https://api.telegram.org

# ============================================================
# Inventory below added 2026-10-22 (TECH-DEBT #11).
#
# These 21 variables were read by the code and documented nowhere.
# An operator cannot set what they cannot see, and the review that
# prompted this found them only by grepping for os.environ rather
# than by reading the docs.
#
# tests/test_env_inventory.py fails if a variable is added to the
# code without appearing here, or if a line here is never read.
# ============================================================

# --- Upload size caps (bytes) ---
# Hard ceilings on what the bot will download. Raise them only if you
# have disk and the platform's own limits in mind.
MAX_PHOTO_BYTES=10000000
MAX_DOC_BYTES=5000000
MAX_VOICE_BYTES=20000000
MAX_VIDEO_NOTE_BYTES=50000000

# --- Storage and context ---
# SQLite path inside the container. Keep this on the volume.
CONVERSATIONS_DB=/app/data/conversations.db
# How many past messages are replayed into the prompt.
CONTEXT_MESSAGES=20
# Time-window policy: window keeps the last BOT_REMEMBER_DAYS days.
CONTEXT_STRATEGY=window
BOT_REMEMBER_DAYS=7
# Absolute ceiling on rows the window may consider.
CONTEXT_MAX_MESSAGES=400

# --- Comma-separated tool names to refuse, e.g. bash_command,web_search ---
DISABLED_TOOLS=

# --- Re-anchoring ---
# Re-anchor the context summary at this local time each day.
BOT_REANCHOR_AT=04:00
# process+engine restarts the engine; process only does not.
BOT_REANCHOR_MODE=process+engine
# Command the operator runs to reset the engine. Documented as
# unreachable in every mode; see docs/TODO.md T68b.
BOT_ENGINE_RESET_CMD=
# IANA zone for the re-anchor clock, e.g. Europe/Moscow.
# Falls back to TZ, then UTC. An unparseable zone logs a warning and
# uses UTC rather than refusing to start.
BOT_REANCHOR_TZ=

# --- Webhook listener ---
# Only read when WEBHOOK_MODE=1.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_PATH=/tg-webhook

# --- MCP servers (imported tools) ---
# The bot can import tools from MCP servers: it asks the server what
# it offers, shows the model those tools, and sends the model's call
# back to that server. Adding a server is a config line, not a code
# change. The servers themselves are the operator's; the model cannot
# add one.
#
# ONE block: a JSON array of server objects. Each object needs a
# `name` (the namespace for its tools -- an imported tool is called
# <name>_<tool>) and a `url` (the MCP endpoint). Optional: `token`
# (sent as `Authorization: Bearer`), `include` / `exclude` (filters
# on the server's OWN tool names, exclude wins), and `gate`
# ("always" | "profile" | "dev-chat"; the default is "profile" --
# every chat except the public profile's).
#
# Example -- the web server on this box, under a name of its own:
# LLAMABOT_MCP_SERVERS=[{"name": "web", "url": "http://127.0.0.1:8765/mcp", "gate": "always"}]
#
# The side-car the bot's shell tool talks to IS in this block in
# production (2026-10-27), under the name "sandbox":
# LLAMABOT_MCP_SERVERS=[{"name": "sandbox", "url": "http://127.0.0.1:8090/mcp", "token_env": "AGENT_STACK_TOKEN", "include": ["read_file", "file_info"], "exclude": ["bash", "delete_file"], "gate": "dev-chat"}]
#
# Three things about that line are worth knowing before editing it:
#   * the side-car speaks MCP from v2.12.0 on; the older v2.10.2 answers
#     404 on /mcp, so the version on the host decides whether this can
#     work at all;
#   * `bash` is excluded on purpose -- the bot already has bash_command
#     against the SAME side-car, and two shells are two policies on one
#     machine;
#   * the address is the host's loopback, and the bot's container runs
#     in the host network, so it reaches it without publishing anything.
#     `token_env` names the variable that holds the token, so the token
#     is not written twice.
#
# MCP_CALL_TIMEOUT: how long a TOOL CALL may take. A crawl is slow on
# purpose, so this one is generous (default 60 seconds).
# MCP_CONNECT_TIMEOUT: how long the HANDSHAKE may take. This one runs
# while the model waits for its tool list, so it is short (default 5
# seconds): a server that cannot be reached in five is not going to
# be reached in sixty either.
# MCP_CALL_TIMEOUT=60
# MCP_CONNECT_TIMEOUT=5

# --- Whisper ---
# Language hint for transcription. Empty means autodetect.
WHISPER_LANGUAGE=ru

# --- Diagnostics ---
# Set to 1 to log the full engine request/response payload.
# Writes prompts and user text to the log. Leave off in production.
# LLAMABOT_DEBUG_PAYLOAD=

