# All variables except BOT_TOKEN have sensible defaults baked into bot.py:
#   LLAMA_URL   default = http://localhost:8080/v1
#   WHISPER_URL default = http://localhost:8000
#   API_KEY     default = sk-no-key  (llama-server without --api-key accepts any
#                                   non-empty bearer; this is a placeholder, not
#                                   a real token)
#   MODEL       default = empty — bot queries /v1/models on llama-server and
#                                 uses the first model it returns
#
# Set these in your local .env only if your deployment differs from the defaults.
# .env is git-ignored and must NEVER be committed.

# Telegram bot token from @BotFather. Required — bot will not start without it.
BOT_TOKEN=

# Override defaults only if your llama-server / whisper-api are not on localhost
# or on a different port. Examples:
#   LLAMA_URL=http://192.168.1.42:8080/v1
#   WHISPER_URL=http://whisper.lan:9000
#   API_KEY=<some-actual-bearer-if-your-server-requires-it>
#   MODEL=my-custom-alias

# === Optional: size limits for uploaded media ===
# Default values are shown. Lower them for a constrained host,
# raise them for a workstation with plenty of RAM.
#   MAX_PHOTO_BYTES=10000000       # 10 MB
#   MAX_DOC_BYTES=5000000         # 5 MB
#   MAX_VOICE_BYTES=20000000      # 20 MB
#   MAX_VIDEO_NOTE_BYTES=50000000 # 50 MB (round video)

# === Optional: where the SQLite conversation database lives ===
# Default: /app/data/conversations.db (persisted via the bind-mount in
# docker-compose.yml). Set to an absolute path on a persistent volume.
#   CONVERSATIONS_DB=/var/lib/telegram-bot/conversations.db

# === Optional: how many messages per sub-talk to keep in the model's
# context window. Older messages stay in the DB but are not sent.
#   CONTEXT_MESSAGES=20

# === Optional: override default URLs ===
#   DONSETCH_URL=http://localhost:8765/mcp

# === Optional: runtime smoke test on bot startup ===
# Set to 1 to fire a synthetic /start + vision test against llama-server.
# Useful after `docker compose up` to verify the bot can reach the model.
# The test uses a fake user_id=0 and a 'selftest:' conversation key, so it
# does not pollute any real user's history.
#   LLAMABOT_SELFTEST=1

# === Security: bot will reject anyone not in this list ===
# Comma-separated numeric Telegram user IDs.
ALLOWED_USER_IDS=

# Comma-separated Telegram usernames (case-insensitive, without @).
ALLOWED_USERNAMES=
