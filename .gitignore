# Never commit real .env files
.env
*.env
!.env.example

# Telegram bot user state
files/*
!files/.gitkeep

# Persistent SQLite conversation store. Lives at ./data/ on the
# host (via docker-compose bind-mount) and must NEVER be committed —
# it contains the actual conversation history of every whitelisted user.
data/*
!data/.gitkeep

# Whisper downloaded model weights
whisper-api/cache/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
